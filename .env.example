# ===========================================================================
# LOOPMESH — environment template
# Copy the backend section to backend/.env and the frontend section to
# frontend/.env.local. Never commit the resulting files.
# ===========================================================================

# ---------------------------------------------------------------------------
# BACKEND  (backend/.env)
# ---------------------------------------------------------------------------

# development | test | staging | production
ENVIRONMENT=development
DEBUG=false

# PostgreSQL is the target database. Alembic migrations are written for it.
# Format: postgresql+psycopg://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL=postgresql+psycopg://loopmesh:loopmesh@localhost:5432/loopmesh

# If DATABASE_URL is left unset the backend falls back to a local SQLite file
# (backend/loopmesh_dev.db) so the demo can run without a database server.
# That fallback is for local development only.

# Comma-separated browser origins allowed to call the API.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# INFO | DEBUG | WARNING | ERROR
LOG_LEVEL=INFO
# true = one JSON object per line (recommended for production log shipping)
LOG_JSON=true

# Deterministic discovery: opportunities below this compatibility score (0-100)
# are not persisted. Raise it to make matching stricter.
DISCOVERY_MIN_SCORE=55
# Safety cap on supply/demand pairs evaluated per discovery run.
DISCOVERY_MAX_PAIRS=2000

# ---------------------------------------------------------------------------
# PLATFORM GOVERNANCE (backend, required for operator MFA)
# ---------------------------------------------------------------------------
# URL-safe base64 Fernet key used to encrypt TOTP secrets at rest. Generate a
# new key with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# There is no default and no plaintext fallback: when this is absent or invalid,
# MFA enrol/confirm/verify fail closed with 503 mfa_unavailable. Never reuse a
# key from another environment and never commit the real value.
MFA_ENCRYPTION_KEY=
# During controlled rotation list the retiring keys (comma separated). The
# primary key above encrypts new secrets; previous keys remain readable until
# `python -m app.scripts.security_ops mfa-rotate` completes and they are removed.
MFA_ENCRYPTION_PREVIOUS_KEYS=
MFA_ROTATION_BATCH_SIZE=100
# Durable brute-force lockout (per operator) and the shared, database-backed
# fixed-window limiter. The database row is authoritative across workers and
# fails closed when unavailable (no per-process allowance for auth/MFA).
AUTH_LOGIN_ATTEMPTS_PER_HOUR=20
AUTH_RESET_ATTEMPTS_PER_HOUR=5
MFA_MAX_FAILED_ATTEMPTS=5
MFA_LOCKOUT_MINUTES=15
MFA_ATTEMPTS_PER_5_MINUTES=10
SECURITY_LIMITER_RETENTION_HOURS=24
# Two-person approval lifetime. Bounded: 5 minutes to 24 hours.
PLATFORM_APPROVAL_TTL_MINUTES=60
# Platform session limits. Idle is checked from the last request; the absolute
# limit is checked from the MFA verification time.
PLATFORM_SESSION_IDLE_MINUTES=30
PLATFORM_SESSION_ABSOLUTE_HOURS=8
# Bounded audit export, chain verification and external archival.
PLATFORM_AUDIT_EXPORT_MAX_ROWS=5000
PLATFORM_AUDIT_EXPORT_MAX_RANGE_DAYS=90
AUDIT_VERIFY_BATCH_SIZE=500
AUDIT_ARCHIVE_BATCH_SIZE=500

# Gemini is server-side only and is NOT used in Phase 1. Leave empty.
# Never expose this value to the frontend or commit it.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# ---------------------------------------------------------------------------
# FRONTEND  (frontend/.env.local)
# ---------------------------------------------------------------------------

# Browser-visible base URL of the FastAPI service.
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000
# Server-side (Next.js server components) base URL of the FastAPI service.
API_INTERNAL_URL=http://127.0.0.1:8000
